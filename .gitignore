# ---------------------------------------------------------------
# OpenNovella .gitignore - keeps binaries and build output out of git
# ---------------------------------------------------------------

# Python bytecode and compiled extensions
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Native binaries, libraries and object files
*.exe
*.dll
*.dylib
*.lib
*.a
*.o
*.obj
*.out
*.app/
*.msi
*.dmg
*.deb
*.rpm
*.AppImage

# Build, packaging and distribution directories
build/
dist/
out/
*.egg-info/
*.egg
.eggs/
wheels/
*.whl
pip-wheel-metadata/
develop-eggs/
sdist/

# PyInstaller / py2app / Nuitka output
*.spec
*.manifest
*.build/
*.dist/
*.onefile-build/

# Exported games (File > Export Game creates "<title> (game)")
*(game)/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, coverage and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Player save data, settings and crash logs (created inside each project)
saves/
crash.log
bug_report.txt
*.tmp

# Demo art is generated by examples/demo/make_art.py, not stored in git
examples/demo/images/*.png
examples/demo/images/rain/
examples/demo/audio/*.wav

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
